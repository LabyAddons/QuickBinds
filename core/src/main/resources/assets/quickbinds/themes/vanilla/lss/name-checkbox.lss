.name-checkbox-container {
  width: 160;
  height: fit-content;
  left: 50%;
  alignment-x: center;
  space-between-entries: 6;

  .input-preview {
    left: 50%;
    alignment-x: center;
    font-size: 1;
    padding: 2 3 2 3;
    max-width: 100%;
    width: 100;
  }

  .checkbox-list {
    width: 100%;
    height: fit-content;
    space-between-entries: 3;

    .checkbox-row {
      width: 100%;
      height: 12;
      space-between-entries: 4;

      .checkbox {
        width: 10;
        height: 10;
        alignment-y: center;
      }

      .checkbox-label {
        alignment-y: center;
      }
    }
  }
}
