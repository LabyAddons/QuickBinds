.header, .footer {
  left: 0;
  width: 100%;

  priority-layer: normal;

  renderer: "DirtBackground";
  background-always-dirt: true;
  background-dirt-type: menu;
}

.header {
  top: 0;
  height: 48;

  .title {
    left: 50%;
    top: 8;
    alignment-x: center;
  }

  .search {
    left: 50%;
    top: 22;
    alignment-x: center;
    width: 220;
    height: 18;
    padding: 2 3 2 3;
  }
}

.options-container {
  left: 0;
  top: 48;
  right: 0;
  bottom: 62;

  renderer: "DirtBackground";
  background-always-dirt: true;
  background-dirt-type: list;
  box-shadow: classic top bottom;

  .menu {
    left: 50%;
    top: 20;
    width: 310;
    max-width: 95%;
    height: fit-content;
    alignment-x: center;
    space-between-entries: 4;

    .menu-row {
      width: 100%;
      height: 20;
      layout: fill;
      space-between-entries: 10;
    }
  }

  .options-scroll {
    left: 50%;
    top: 4;
    bottom: 4;
    width: 360;
    max-width: 95%;
    alignment-x: center;

    .options-list {
      width: 100%;
      height: fit-content;
      space-between-entries: 2;

      .category {
        left: 50%;
        alignment-x: center;
        margin-top: 8;
        margin-bottom: 3;
      }

      .empty {
        left: 50%;
        alignment-x: center;
        margin-top: 12;
      }

      .option-row {
        width: 100%;
        height: 20;
        padding: 0 4 0 4;

        &:hover {
          background-color: rgba(255, 255, 255, 20);
        }

        .option-name {
          top: 50%;
          alignment-y: center;
        }

        .option-controls {
          alignment: right;
          width: fit-content;
          height: 100%;
          space-between-entries: 2;

          .option-value {
            width: 120;
            height: 20;
          }

          .option-switch {
            top: 50%;
            alignment-y: center;
          }

          .option-revert {
            width: 20;
            height: 20;
          }
        }
      }
    }
  }
}

.footer {
  bottom: 0;
  height: 62;

  .warning {
    left: 50%;
    top: 4;
    alignment-x: center;
  }

  .hint {
    left: 50%;
    top: 16;
    alignment-x: center;
  }

  .button-row {
    left: 50%;
    top: 34;
    width: 250;
    max-width: 95%;
    height: 20;
    alignment-x: center;
    layout: fill;
    space-between-entries: 8;
  }
}

.error {
  left: 50%;
  top: 50%;
  max-width: 80%;
  alignment-x: center;
  alignment-y: center;
  text-alignment: center;
}
